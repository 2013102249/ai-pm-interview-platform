# 复制为 server/.env 并填入真实值（该文件已被 .gitignore 忽略，不会进入仓库）

# 飞书自建应用凭据（开放平台 → 开发者后台 → 应用详情）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格（默认值即当前题库所在 Base，一般无需修改）
FEISHU_BASE_TOKEN=UDXYbBLFqaQtrnsF8Mncn2PDndg
FEISHU_TABLE_ACCOUNT=tblL2xHFCj3Yzaro
FEISHU_TABLE_PROGRESS=tblhcHe8RI1WCm1E

# 会话签名密钥，随便一串长随机字符；变更后所有学员需重新登录
SESSION_SECRET=please-change-this-to-a-long-random-string

# 允许跨域调用 API 的前端来源，多个用逗号分隔；* 表示不限制
ALLOW_ORIGIN=https://2013102249.github.io,http://localhost:3000

PORT=3000
